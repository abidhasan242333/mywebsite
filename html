<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Special Offer</title>

<style>
*{
    box-sizing:border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body{
    margin:0;
    background:linear-gradient(135deg,#eef7ff,#ffffff);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.wrapper{
    width:100%;
    max-width:430px;
    padding:20px;
}

.box{
    background:white;
    border-radius:30px;
    padding:25px 20px;
    box-shadow:0 15px 40px rgba(0,0,0,.12);
    text-align:center;
    overflow:hidden;
}


.gift{
    width:90px;
    height:90px;
    margin:auto;
    background:linear-gradient(135deg,#ff5252,#ff9800);
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:45px;
    animation:bounce 2s infinite;
}

@keyframes bounce{
    50%{
        transform:translateY(-10px);
    }
}


h1{
    color:#126b35;
    font-size:30px;
    margin:20px 0 8px;
}

.subtitle{
    color:#777;
    font-size:16px;
}


.info{
    margin-top:25px;
    background:#fff8df;
    border-radius:20px;
    padding:20px;
    border:1px solid #ffe8a3;
}

.info h2{
    font-size:20px;
    color:#222;
}

.info p{
    color:#555;
    line-height:1.6;
}


.btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    margin-top:15px;
    padding:18px;
    border-radius:18px;
    color:white;
    text-decoration:none;
    font-size:19px;
    font-weight:600;
    transition:.3s;
}


.btn:hover{
    transform:scale(1.03);
}


.blue{
    background:linear-gradient(90deg,#2196f3,#1976d2);
}

.red{
    background:linear-gradient(90deg,#ff5252,#d32f2f);
}

.orange{
    background:linear-gradient(90deg,#ffb300,#f57c00);
}

.green{
    background:linear-gradient(90deg,#21a842,#087f23);
    margin-top:25px;
}


.footer{
    margin-top:20px;
    color:#888;
    font-size:13px;
}

</style>

</head>

<body>

<div class="wrapper">

<div class="box">

<div class="gift">🎁</div>

<h1>Special Offer</h1>

<div class="subtitle">
Exclusive rewards and benefits
</div>


<div class="info">

<h2>Welcome!</h2>

<p>
Choose your preferred option below
and continue to explore our services.
</p>

</div>


<a href="#" class="btn blue">
📱 Option One
</a>


<a href="#" class="btn red">
📱 Option Two
</a>


<a href="#" class="btn orange">
📱 Option Three
</a>


<a href="#" class="btn green">
🎁 Continue →
</a>


<div class="footer">
© 2026 Your Website. All rights reserved.
</div>


</div>

</div>

</body>
</html>
